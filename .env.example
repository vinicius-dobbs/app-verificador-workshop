# Oficina Inji local: substitua SEU_IP_DA_REDE pelo IPv4 do computador
# alcançável pelo emulador Android, pela carteira e pelos contêineres.
# Use o mesmo IP configurado em WORKSHOP_HOST no Docker Compose da oficina.
# Não use localhost nem 10.0.2.2: o DID do Verify inclui esse endereço e a porta.
EXPO_PUBLIC_BASE_URL=http://SEU_IP_DA_REDE:31180
EXPO_PUBLIC_CLIENT_ID=did:web:SEU_IP_DA_REDE%3A31180:v1:verify
EXPO_PUBLIC_CERTIFY_WELLKNOWN_URL=http://SEU_IP_DA_REDE:31090/v1/certify/.well-known/openid-credential-issuer

# Variáveis EXPO_PUBLIC_ são embutidas no aplicativo. Nunca coloque tokens,
# senhas, chaves privadas ou client secrets nelas.
